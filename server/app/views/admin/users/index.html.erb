<h1>Usuarios</h1>
<%= link_to "Nuevo usuario", new_admin_user_path %>
<table>
  <tr><th>Nombre</th><th>Email</th><th>Admin</th><th></th></tr>
  <% @users.each do |user| %>
    <tr>
      <td><%= link_to user.name, admin_user_path(user) %></td>
      <td><%= user.email %></td>
      <td><%= user.admin? ? "Sí" : "No" %></td>
      <td>
        <%= link_to "Editar", edit_admin_user_path(user) %>
        <%= button_to "Eliminar", admin_user_path(user), method: :delete %>
      </td>
    </tr>
  <% end %>
</table>
