<h1><%= @user.name %></h1>
<% if @user.avatar.attached? %>
  <%= image_tag @user.avatar, style: "max-width:120px; border-radius:8px;" %>
<% else %>
  <p>Sin avatar</p>
<% end %>
<p><%= @user.email %></p>
<p>Admin: <%= @user.admin? ? "Sí" : "No" %></p>
<%= link_to "Editar", edit_admin_user_path(@user) %>
<%= link_to "Volver", admin_users_path %>
