<h1>Memberships</h1>
<%= link_to "Nuevo membership", new_admin_membership_path %>
<table>
  <tr><th>Usuario</th><th>Workspace</th><th>Rol</th><th></th></tr>
  <% @memberships.each do |membership| %>
    <tr>
      <td><%= membership.user.name %></td>
      <td><%= membership.workspace.name %></td>
      <td><%= membership.role %></td>
      <td><%= button_to "Eliminar", admin_membership_path(membership), method: :delete %></td>
    </tr>
  <% end %>
</table>
