<h1><%= @workspace.name %></h1>
<p>Dueño: <%= @workspace.owner.name %></p>
<h2>Canales</h2>
<ul>
  <% @workspace.channels.each do |channel| %>
    <li><%= link_to channel.name || "Directo", admin_channel_path(channel) %></li>
  <% end %>
</ul>
<%= link_to "Nuevo canal", new_admin_workspace_channel_path(@workspace) %>
<%= link_to "Editar", edit_admin_workspace_path(@workspace) %>
<%= link_to "Volver", admin_workspaces_path %>
